# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/scopeflow
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Server Configuration
SERVER_PORT=8080
USER_SERVICE_PORT=8081

# JWT Configuration
# IMPORTANTE: Este secret é COMPARTILHADO entre monólito e user-service.
# Em produção: use secret manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# Geração: openssl rand -hex 32 (mínimo 32 caracteres)
JWT_SECRET=your-secret-key-change-in-production-minimum-32-characters-long

# OpenAI Configuration
OPENAI_API_KEY=sk-...

# AWS Configuration
S3_BUCKET=scopeflow-mvp
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AUTH_DOMAIN=localhost

# Spring Security — usuário admin do actuator/basic auth
# OBRIGATÓRIO: sem valor padrão no application.yml — app não sobe sem esta var
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=troque-esta-senha-antes-de-usar

# Optional: Spring Profiles
SPRING_PROFILES_ACTIVE=dev

# ============================================================================
# User Service — Banco Dedicado (DB-per-service unificado)
# ============================================================================
# Ambos monólito e user-service usam o MESMO servidor PostgreSQL (porta 5432),
# mas databases separados: scopeflow (monólito) e scopeflow_users (user-service).
# O serviço user-db foi removido na S5 — não existe mais container separado.
# Ver: docs/migration/DB-MIGRATION-USER-SERVICE.md
USER_SERVICE_DATABASE_URL=jdbc:postgresql://localhost:5432/scopeflow_users

AUTH_SERVICE_EXTRACTED=true
AUTH_SERVICE_URL=http://localhost:8081/api/v1

# ============================================================================
# Rate Limiter
# Configure com o IP do Traefik antes de subir em staging.
# Sem trusted-proxies configurado → sempre usa RemoteAddr.
# Com Traefik configurado → pega o IP real do cliente via rightmost X-Forwarded-For.
# ============================================================================
APP_RATE_LIMIT_TRUSTED_PROXIES=
