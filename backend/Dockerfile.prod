# Dockerfile.prod — variante de produção
#
# Diferença em relação ao Dockerfile padrão:
#   - Inclui dumb-init como PID 1 para reencaminhar sinais corretamente
#     em ambientes que não passam SIGTERM direto ao processo Java
#     (e.g., alguns runtimes ECS/EC2 sem suporte a init nativo).
#   - Em Kubernetes com terminationGracePeriodSeconds configurado,
#     o Dockerfile padrão (sem dumb-init) é suficiente — o kubelet
#     envia SIGTERM diretamente ao processo Java (PID 1 no container).
#   - Use Dockerfile.prod se seu runtime de deploy não for Kubernetes
#     ou se você quiser a camada extra de segurança do dumb-init.
#
# Para builds de imagem de produção via CI:
#   docker build -f Dockerfile.prod -t scopeflow-api:$(git rev-parse --short HEAD) .

# Stage 1: Build — usa Maven wrapper para garantir versão controlada
FROM eclipse-temurin:21-jdk-alpine AS builder
LABEL stage=builder

WORKDIR /build

COPY mvnw .
COPY .mvn .mvn
COPY pom.xml .

RUN ./mvnw dependency:go-offline -B -q

COPY src ./src
RUN ./mvnw clean package -Dmaven.test.skip=true -B -q && \
    java -Djarmode=layertools -jar target/scopeflow-api-1.0.0-SNAPSHOT.jar extract --destination target/extracted

# Stage 2: Runtime mínimo com JRE
FROM eclipse-temurin:21-jre-alpine

LABEL maintainer="ScopeFlow <support@scopeflow.com>" \
      description="ScopeFlow API - AI-powered B2B SaaS (production variant)" \
      org.opencontainers.image.source="https://github.com/scopeflow/backend"

# dumb-init: processo PID 1 leve que reencaminha sinais Unix para o processo filho
# Garante graceful shutdown em ambientes que não usam Kubernetes como runtime principal
RUN apk add --no-cache dumb-init

RUN addgroup -g 1000 scopeflow && \
    adduser -D -u 1000 -G scopeflow scopeflow

WORKDIR /app

COPY --from=builder --chown=scopeflow:scopeflow /build/target/extracted/dependencies/ ./
COPY --from=builder --chown=scopeflow:scopeflow /build/target/extracted/spring-boot-loader/ ./
COPY --from=builder --chown=scopeflow:scopeflow /build/target/extracted/snapshot-dependencies/ ./
COPY --from=builder --chown=scopeflow:scopeflow /build/target/extracted/application/ ./

USER scopeflow:scopeflow

EXPOSE 8080

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/api/v1/health || exit 1

# dumb-init como PID 1 — repassa SIGTERM para o processo Java filho
ENTRYPOINT ["dumb-init", "--"]

# Flags JVM: ver comentário no Dockerfile padrão para explicação completa
# JAVA_TOOL_OPTIONS é respeitado automaticamente pela JVM — permite override via env var no Kubernetes
# sem precisar mudar o CMD (ex: injetar -agentlib:jdwp para debug pontual)
CMD ["java", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=75.0", \
    "-XX:+UseG1GC", \
    "-XX:MaxGCPauseMillis=200", \
    "-XX:+HeapDumpOnOutOfMemoryError", \
    "-XX:HeapDumpPath=/tmp/", \
    "-Dspring.threads.virtual.enabled=true", \
    "-Dspring.lifecycle.timeout-per-shutdown-phase=${SHUTDOWN_TIMEOUT:-20s}", \
    "org.springframework.boot.loader.launch.JarLauncher"]
